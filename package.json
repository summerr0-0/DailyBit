{
  "name": "dailybit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "dev:local": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dailybit DIRECT_URL=postgresql://postgres:postgres@localhost:5433/dailybit next dev",
    "db:push:local": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dailybit DIRECT_URL=postgresql://postgres:postgres@localhost:5433/dailybit prisma db push",
    "db:seed:local": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dailybit DIRECT_URL=postgresql://postgres:postgres@localhost:5433/dailybit tsx prisma/seed.ts",
    "db:studio:local": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dailybit DIRECT_URL=postgresql://postgres:postgres@localhost:5433/dailybit prisma studio",
    "db:dev:up": "docker start dailybit-dev-db || docker run -d --name dailybit-dev-db -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=dailybit -p 5433:5432 postgres:16",
    "db:dev:down": "docker stop dailybit-dev-db",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm test:run && pnpm test:e2e"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "sharp"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@base-ui/react": "^1.5.0",
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
