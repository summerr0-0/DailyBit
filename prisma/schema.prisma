generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AiCollab {
  NONE
  HINT
  LED
}

enum SourceType {
  URL
  TEXT
  YOUTUBE
}

// 초안 출처: 수동 스크랩(MANUAL) vs 자동 뉴스 큐레이션(NEWS). spec: news-curation D10
enum DraftKind {
  MANUAL
  NEWS
  CONCEPT
}

// 뉴스 사건 상태. spec: news-curation-v2 D9, D12
enum NewsEventStatus {
  OPEN
  PUBLISHED
  DISCARDED
  EXPIRED
}

// 초보자 개념 상태. spec: news-curation-v2 D5, D12
enum ConceptStatus {
  PENDING
  PUBLISHED
  REJECTED
}

// 자동 수집 기사 상태. spec: news-curation D15 상태 전이표
enum FeedItemStatus {
  CANDIDATE
  SKIPPED
  FAILED
  DRAFTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  nickname  String   @unique
  bio       String?  @db.VarChar(150)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bits        Bit[]
  rebits      Rebit[]
  threads     Thread[]
  scrapDrafts ScrapDraft[]

  @@map("users")
}

model Thread {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(100)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bits Bit[]

  @@map("threads")
}

model Bit {
  id        String   @id @default(cuid())
  content   String   @db.VarChar(500)
  tags      String[]
  aiCollab  AiCollab @default(NONE)
  pinned    Boolean  @default(false)
  private   Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  threadId  String?
  thread    Thread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rebits   Rebit[]
  likes    Like[]
  comments Comment[]

  @@map("bits")
}

model Rebit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bitId     String
  bit       Bit      @relation(fields: [bitId], references: [id], onDelete: Cascade)
  message   String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  @@unique([userId, bitId])
  @@index([bitId])
  @@map("rebits")
}

model Like {
  id        String   @id @default(cuid())
  bitId     String
  bit       Bit      @relation(fields: [bitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("likes")
}

model PrivateTag {
  tag       String   @id
  createdAt DateTime @default(now())

  @@map("private_tags")
}

model Comment {
  id           String   @id @default(cuid())
  content      String   @db.VarChar(300)
  author       String   @default("Anonymous")
  passwordHash String?
  bitId        String
  bit          Bit      @relation(fields: [bitId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@map("comments")
}

// 테크 글 스크랩 초안. 컨펌 발행 전까지만 존재하는 임시 데이터(비공개, 오너 전용).
// segments = 발행 후보 배열 [{ content: string(≤500), tags: string[] }].
// 세그먼트 1개면 Bit, 2개 이상이면 Thread로 발행 후 이 행은 삭제된다.
model ScrapDraft {
  id                   String     @id @default(cuid())
  sourceType           SourceType
  sourceUrl            String?
  sourceTitle          String?
  rawExtract           String     @db.Text
  segments             Json
  suggestedThreadTitle String?    @db.VarChar(100)
  kind                 DraftKind  @default(MANUAL)
  sourceLabel          String?
  warnings             String[]   @default([])
  feedItemId           String?    @unique
  feedItem             FeedItem?  @relation(fields: [feedItemId], references: [id], onDelete: SetNull)
  eventKey             String?
  conceptSlugs         String[]   @default([])
  conceptId            String?
  authorId             String
  author               User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([authorId])
  @@index([kind, createdAt])
  @@index([eventKey])
  @@map("scrap_drafts")
}

// 자동 뉴스 큐레이션이 본 기사. urlNormalized로 중복 제거하고 status로 재처리 여부를 결정한다.
// spec: news-curation D5, D15
model FeedItem {
  id            String         @id @default(cuid())
  url           String
  urlNormalized String         @unique
  sourceId      String
  title         String
  summary       String?        @db.Text
  publishedAt   DateTime?
  firstSeenAt   DateTime       @default(now())
  score         Int?
  status        FeedItemStatus
  skipReason    String?
  attempts      Int            @default(0)
  eventKey      String?
  updatedAt     DateTime       @updatedAt

  draft ScrapDraft?

  @@index([status, publishedAt])
  @@map("feed_items")
}

// 뉴스 사건 — 열림/발행/폐기/만료의 단일 출처. spec: news-curation-v2 D9
model NewsEvent {
  id        String          @id @default(cuid())
  eventKey  String          @unique
  title     String
  status    NewsEventStatus @default(OPEN)
  draftId   String?         @unique
  threadId  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status, updatedAt])
  @@map("news_events")
}

// 초보자 개념 — 개념 Thread와 연결. spec: news-curation-v2 D5, D14-3
model Concept {
  id        String        @id @default(cuid())
  slug      String        @unique
  term      String
  aliases   String[]      @default([])
  status    ConceptStatus @default(PENDING)
  threadId  String?
  draftId   String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  events ConceptEvent[]

  @@map("concepts")
}

// 개념 ↔ 사건 다대다 (D14-3)
model ConceptEvent {
  id        String   @id @default(cuid())
  conceptId String
  concept   Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  eventKey  String
  createdAt DateTime @default(now())

  @@unique([conceptId, eventKey])
  @@index([eventKey])
  @@map("concept_events")
}

// 캐나다 영주권 선발 기록 (spec: immigration-monitor D1). 오너 전용 /immigration 화면에서만 보인다.
// dedupeKey = sha256(program|drawDate|stream|detail) — 같은 선발을 두 번 넣지 않는다.
model ImmigrationDraw {
  id              String   @id @default(cuid())
  dedupeKey       String   @unique @db.VarChar(64)
  program         String   @db.VarChar(20)
  stream          String   @db.VarChar(300)
  detail          String   @default("") @db.Text
  drawDate        DateTime @db.Date
  minScore        Int?
  invitations     Int?
  invitationsText String   @default("") @db.VarChar(40)
  sourceUrl       String
  createdAt       DateTime @default(now())

  @@index([program, drawDate])
  @@map("immigration_draws")
}

// 공식 공지 페이지의 마지막 본문 (spec: immigration-monitor D4). 해시가 바뀌면 새 줄만 알린다.
model PageSnapshot {
  url       String   @id
  hash      String   @db.VarChar(64)
  text      String   @db.Text
  checkedAt DateTime @default(now())
  changedAt DateTime @default(now())

  @@map("page_snapshots")
}
