generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AiCollab {
  NONE
  HINT
  LED
}

enum SourceType {
  URL
  TEXT
  YOUTUBE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  nickname  String   @unique
  bio       String?  @db.VarChar(150)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bits        Bit[]
  rebits      Rebit[]
  threads     Thread[]
  scrapDrafts ScrapDraft[]

  @@map("users")
}

model Thread {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(100)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bits      Bit[]

  @@map("threads")
}

model Bit {
  id        String    @id @default(cuid())
  content   String    @db.VarChar(500)
  tags      String[]
  aiCollab  AiCollab  @default(NONE)
  pinned    Boolean   @default(false)
  private   Boolean   @default(false)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  threadId  String?
  thread    Thread?   @relation(fields: [threadId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rebits    Rebit[]
  likes     Like[]
  comments  Comment[]

  @@map("bits")
}

model Rebit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bitId     String
  bit       Bit      @relation(fields: [bitId], references: [id], onDelete: Cascade)
  message   String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  @@unique([userId, bitId])
  @@index([bitId])
  @@map("rebits")
}

model Like {
  id        String   @id @default(cuid())
  bitId     String
  bit       Bit      @relation(fields: [bitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("likes")
}

model PrivateTag {
  tag       String   @id
  createdAt DateTime @default(now())

  @@map("private_tags")
}

model Comment {
  id           String   @id @default(cuid())
  content      String   @db.VarChar(300)
  author       String   @default("Anonymous")
  passwordHash String?
  bitId        String
  bit          Bit      @relation(fields: [bitId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@map("comments")
}

// 테크 글 스크랩 초안. 컨펌 발행 전까지만 존재하는 임시 데이터(비공개, 오너 전용).
// segments = 발행 후보 배열 [{ content: string(≤500), tags: string[] }].
// 세그먼트 1개면 Bit, 2개 이상이면 Thread로 발행 후 이 행은 삭제된다.
model ScrapDraft {
  id                   String     @id @default(cuid())
  sourceType           SourceType
  sourceUrl            String?
  sourceTitle          String?
  rawExtract           String     @db.Text
  segments             Json
  suggestedThreadTitle String?    @db.VarChar(100)
  authorId             String
  author               User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([authorId])
  @@map("scrap_drafts")
}
